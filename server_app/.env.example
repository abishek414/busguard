# Settings for BusGuard. The real values go in a file called .env (kept private).

SECRET_KEY=put-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=*
# The site's public https address, e.g. https://busguard-darwin.australiaeast.cloudapp.azure.com
SITE_URL=http://127.0.0.1:8000

# ---- AI ----
FIGHT_MODEL_PATH=models/fight_cls.pt
# A photo counts as "fight" at or above this score (0.0 - 1.0)
FIGHT_THRESHOLD=0.6
# The bus is told to record a clip when FIGHT_HITS of the last FIGHT_WINDOW photos look like a fight
FIGHT_HITS=3
FIGHT_WINDOW=6
# A fight score only counts when at least this many people are in the picture (0 = don't check)
FIGHT_MIN_PEOPLE=1
# Pictures less sharp than this count as "camera blocked or view unclear" (lower = stricter)
VIEW_MIN_SHARPNESS=80
# Seconds before the same bus can raise another alert
ALERT_COOLDOWN=60
# Show each bus's latest photo in the control room (set False for privacy)
SHOW_LIVE_FRAMES=True
# Length of the clip recorded by the phone camera page (/cam/<bus key>/)
PHONE_CLIP_SECONDS=20

# ---- Self-learning (Retrain AI button) ----
# Training rounds per retrain (more = slower, maybe better)
RETRAIN_EPOCHS=3
TRAINING_DIR=training_data
